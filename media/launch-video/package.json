{
  "name": "agentl-launch-video",
  "private": true,
  "description": "Launch video for agentl, rendered with Remotion.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Launch out/agentl-launch.mp4 --codec=h264 --crf=16",
    "sources": "python3 scripts/sources.py",
    "render:clips": "bash scripts/render-clips.sh",
    "render:compress": "remotion render src/index.ts Compress out/agentl-compress.mp4 --codec=h264 --crf=16",
    "render:promo": "remotion render src/index.ts Promo out/agentl-promo.mp4 --codec=h264 --crf=18",
    "render:promo-vertical": "remotion render src/index.ts PromoVertical out/agentl-promo-vertical.mp4 --codec=h264 --crf=18",
    "render:terminal": "remotion render src/index.ts Terminal out/agentl-terminal.mp4 --codec=h264 --crf=18",
    "render:terminal-vertical": "remotion render src/index.ts TerminalVertical out/agentl-terminal-vertical.mp4 --codec=h264 --crf=18",
    "render:notify": "remotion render src/index.ts Notify out/agentl-notify.mp4 --codec=h264 --crf=18",
    "render:notify-vertical": "remotion render src/index.ts NotifyVertical out/agentl-notify-vertical.mp4 --codec=h264 --crf=18",
    "render:x": "remotion render src/index.ts XPayTwice out/x-pay-twice.mp4 --codec=h264 --crf=18 && remotion render src/index.ts XMillion out/x-million.mp4 --codec=h264 --crf=18 && remotion render src/index.ts XNfe out/x-nfe.mp4 --codec=h264 --crf=18",
    "poster": "remotion still src/index.ts Launch out/poster.jpg --frame=600"
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "@fontsource/outfit": "^5.1.0",
    "@remotion/cli": "4.0.535",
    "@remotion/motion-blur": "^4.0.535",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.535"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
